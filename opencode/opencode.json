{
  "$schema": "https://opencode.ai/config.json",
  "model": "maestro/{env:MAESTRO_MODEL}",
  "small_model": "maestro/{env:MAESTRO_MODEL}",
  "shell": "/bin/bash",
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": false
  },
  "provider": {
    "maestro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "maestro (vLLM)",
      "options": {
        "baseURL": "{env:MAESTRO_BASE_URL}",
        "apiKey": "dummy"
      },
      "models": {
        "{env:MAESTRO_MODEL}": {
          "name": "maestro",
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "audio"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow"
  }
}
